# =====================================================================
# VENDE YA — Environment Variables (example)
# =====================================================================
# Copy this file to .env.local for local dev, and set the same vars
# in Vercel Project Settings → Environment Variables for production.
# =====================================================================

# ---- Database (Prisma) ----
# Local dev: SQLite file (auto-created on `bun run db:push`)
DATABASE_URL="file:./db/custom.db"
# Production (Vercel): use Supabase Postgres pooler URL
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- Supabase (production auth + realtime) ----
NEXT_PUBLIC_SUPABASE_URL="https://qkfgcynfzhjghtsrmdxs.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFrZmdjeW5memhqZ2h0c3JtZHhzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3OTkxNDcsImV4cCI6MjEwMjM3NTE0N30.KBzaXsOIaeZKQosAa1XOUJiXvi996MCVmv1boOqTaIY"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFrZmdjeW5memhqZ2h0c3JtZHhzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njc5OTE0NywiZXhwIjoyMTAyMzc1MTQ3fQ.namOOOx_H0JP1EmGs7k4ai6fiZw1SdaJt4X69iO_DfY"

# ---- Cloudflare Stream (live video) ----
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNING_KEY=""

# ---- Cloudflare R2 (object storage) ----
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="vendeya"
CLOUDFLARE_R2_ACCOUNT_ID=""

# ---- AI Edge (z-ai-web-dev-sdk) ----
ZAI_API_KEY=""

# ---- Realtime (Socket.io mini-service) ----
NEXT_PUBLIC_REALTIME_URL=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="Vende Ya"
NEXT_PUBLIC_DEFAULT_LOCALE="es-PE"
NEXT_PUBLIC_DEFAULT_CURRENCY="PEN"

# ---- Web Push (VAPID keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@vendeya.pe"

# ---- Pagos (Modo A — Split Automático) ----
# Pasarela (Mercado Pago / Culqi)
GATEWAY_ACCESS_TOKEN=""              # Token de acceso de la pasarela (legacy)
GATEWAY_WEBHOOK_SECRET=""           # Secreto compartido para validar webhooks
GATEWAY_MODE="sandbox"              # sandbox | production

# ---- Mercado Pago OAuth (Sprint 2-A) ----
# Crear app en https://www.mercadopago.com.pe/developers/panel/app
# Setear redirect_uri = https://vende-ya-phi.vercel.app/api/wallet/oauth/callback
NEXT_PUBLIC_MP_CLIENT_ID=""         # Client ID público (App ID de Mercado Pago)
MP_CLIENT_SECRET=""                 # Client Secret (server-only, NUNCA en frontend)
MP_ACCESS_TOKEN=""                  # Token de acceso de la cuenta de Vende Ya (collector)
MP_COLLECTOR_ID=""                  # user_id de la cuenta de Vende Ya (collector)
NEXT_PUBLIC_MP_COLLECTOR_ID=""      # Mismo que MP_COLLECTOR_ID pero público (frontend)

# Cuando NO están seteadas, el adapter de Mercado Pago opera en modo DEMO
# (simula pagos aprobados + QR mock para pruebas locales)

# ---- Shalom Perú (logística agencia-a-agencia) ----
SHALOM_API_KEY=""
SHALOM_BASE_URL=""                  # https://api.shalom.com.pe/v1 (prod) | sandbox URL
# Si no se setea, el cliente usa modo DEMO con respuestas mock

# ---- Admin / Moderación ----
ADMIN_API_TOKEN=""                  # Token para endpoints admin (ban, list reports)
LEGAL_CONTACT_EMAIL="legal@vendeya.pe"
MODERATION_EMAIL="moderacion@vendeya.pe"

# ---- App URL (for OAuth redirects) ----
NEXT_PUBLIC_APP_URL="https://vende-ya-phi.vercel.app"
